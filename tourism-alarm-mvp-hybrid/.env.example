# Tourism Alarm — configuración local
#
# Copia este fichero a .env y rellénalo. .env está en .gitignore: NUNCA se sube.

# ── Supabase ────────────────────────────────────────────────────────────────
# Panel de Supabase → Project Settings → API

SUPABASE_URL=https://dsscahrsdwnsznyknkzb.supabase.co

# service_role key: la usan los RECOLECTORES que corren en tu ordenador.
# Salta las políticas RLS, así que un script puede escribir sin iniciar sesión.
# ⚠️ Nunca la subas al repositorio ni la pongas en el navegador: quien la tenga
#    tiene acceso total a la base de datos.
SUPABASE_SERVICE_KEY=

# Clave publicable: la usa la PÁGINA DE REVISIÓN en el navegador.
# Esta sí puede ir en el bundle — no da acceso a nada por sí sola, porque las
# políticas RLS exigen sesión iniciada.
VITE_SUPABASE_URL=https://dsscahrsdwnsznyknkzb.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_bkJexEZIiAngR-p75ValwQ_QtniF_r8

# ── Agentes de enriquecimiento (opcional, pipeline antiguo) ─────────────────
# Ojo: los agentes de agents/ piden a un LLM que ESTIME ocupaciones, es decir,
# que se invente cifras. No alimentan el mapa. Ver README.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
